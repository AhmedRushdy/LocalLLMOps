# Copy to .env and adjust. Docker Compose reads this file automatically.

# Backends (host networking: 127.0.0.1 reaches services on the host)
OLLAMA_URL=http://127.0.0.1:11434
VLLM_URL=http://127.0.0.1:8000
OLLAMA_MODEL=qwen2.5:0.5b
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Gateway behaviour
REQUEST_TIMEOUT=120
CONNECT_TIMEOUT=10
HEALTH_TIMEOUT=5
HEALTH_PROBE_INTERVAL=15
MAX_CONCURRENT_REQUESTS=8
MAX_CONNECTIONS=100
LOG_LEVEL=INFO

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-lab-admin
